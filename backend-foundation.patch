@@ -0,0 +1,47 @@
+using System.Net;
+
+namespace IntegrationTests.Api;
+
+public sealed class CorsPolicyTests(IntegrationTestWebAppFactory factory)
+    : BaseIntegrationTest(factory)
+{
+    private const string AllowedOrigin = "http://localhost:5173";
+
+    [Fact]
+    public async Task Preflight_FromAllowedOrigin_Should_AllowCredentialsForExactOrigin()
+    {
+        using HttpRequestMessage request = CreatePreflightRequest(AllowedOrigin);
+
+        using HttpResponseMessage response = await HttpClient.SendAsync(request);
+
+        response.StatusCode.ShouldBe(HttpStatusCode.NoContent);
+        response.Headers.GetValues("Access-Control-Allow-Origin").ShouldBe([AllowedOrigin]);
+        response.Headers.GetValues("Access-Control-Allow-Credentials").ShouldBe(["true"]);
+    }
+
+    [Fact]
+    public async Task Preflight_FromUnknownOrigin_Should_NotReceiveCorsGrant()
+    {
+        using HttpRequestMessage request = CreatePreflightRequest("http://localhost:5174");
+
+        using HttpResponseMessage response = await HttpClient.SendAsync(request);
+
+        response.Headers.Contains("Access-Control-Allow-Origin").ShouldBeFalse();
+        response.Headers.Contains("Access-Control-Allow-Credentials").ShouldBeFalse();
+    }
+
+    private static HttpRequestMessage CreatePreflightRequest(string origin)
+    {
+        var request = new HttpRequestMessage(HttpMethod.Options, "warehouses");
+        request.Headers.Add("Origin", origin);
+        request.Headers.Add("Access-Control-Request-Method", "GET");
+        return request;
+    }
+}
