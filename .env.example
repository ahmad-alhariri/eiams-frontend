# Browser-visible configuration. Never place credentials, tokens, cookie values, or secrets in VITE_* variables.
# Keep this origin-relative so the production HTTPS host can proxy the API and
# send the host-only refresh cookie without cross-origin browser access.
VITE_API_BASE_URL=/api/v1

# Development mocks (MSW browser worker) are enabled by default so `pnpm dev`
# works without a backend. Set to "false" to call the real API instead.
# VITE_ENABLE_API_MOCKS=true

# D-SRS-01 singular-session experimental flag. When "true", the frontend
# trusts the contract's single activeScope and never offers a client scope
# picker; the route-guards redirect an authenticated SelectionRequired
# session to /session/no-access instead of /session/scope. Defaults to
# "false" until backend whhu.11 lands the singular session contract; flip
# to "true" to migrate early. Drop the flag entirely once whhu.11 closes.
# VITE_EXPERIMENTAL_SINGULAR_SESSION=false

# Development-only API proxy target (read by the Vite dev server, never exposed
# to browser code). The dev server forwards the configured API path (default
# /api/v1) to this origin so the browser stays same-origin and the host-only
# refresh cookie works without CORS. Set this in .env.local when a real
# backend is running; requests fail with a gateway error when nothing listens.
# EIAMS_DEV_PROXY_TARGET=http://localhost:8080
